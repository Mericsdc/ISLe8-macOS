    "LimitBar LRX'ten taşındı. Bir servisin limiti %90'ı geçince adada kısa bir uyarı çıkar. Giriş, servisin kendi aracıyla yapılır: codex login, claude auth login, agy.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Moved over from LimitBar LRX. When a limit passes 90%, a short alert appears on the island. Sign in with each service's own tool: codex login, claude auth login, agy."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "LimitBar LRX'ten taşındı. Bir servisin limiti %90'ı geçince adada kısa bir uyarı çıkar. Giriş, servisin kendi aracıyla yapılır: codex login, claude auth login, agy."
          }
        }
      }
    },
