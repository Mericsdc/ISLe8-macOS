    },
    "AirDrop ile gelen dosyaları göster ve rafa ekle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Announce files received by AirDrop and put them on the shelf"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "AirDrop ile gelen dosyaları göster ve rafa ekle"
          }
        }
      }
    },
    "AirDrop ile gönder": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send with AirDrop"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "AirDrop ile gönder"
          }
        }
      }
    },
    "AirPods (iki kulaklık ve kutu), Beats, Magic Keyboard, Mouse, Trackpad ve pilini bildiren diğer Bluetooth cihazları. Pil bilgisi macOS'un Bluetooth raporundan, cihaz bağlanınca, ada açılınca ve bağlıyken 10 dakikada bir okunur.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AirPods (both buds and the case), Beats, Magic Keyboard, Mouse, Trackpad and other Bluetooth devices that report their battery. Levels come from macOS's Bluetooth report, read when a device connects, when the island opens and every 10 minutes while connected."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "AirPods (iki kulaklık ve kutu), Beats, Magic Keyboard, Mouse, Trackpad ve pilini bildiren diğer Bluetooth cihazları. Pil bilgisi macOS'un Bluetooth raporundan, cihaz bağlanınca, ada açılınca ve bağlıyken 10 dakikada bir okunur."
          }
        }
      }
    },
    "AirPods, Magic Mouse ya da pilini bildiren başka bir Bluetooth cihazı bağlanınca burada görünür.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AirPods, a Magic Mouse or another Bluetooth device that reports its battery shows up here when it connects."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "AirPods, Magic Mouse ya da pilini bildiren başka bir Bluetooth cihazı bağlanınca burada görünür."
          }
        }
      }
    },
    "Ajan bir komut için izin isteyince adada Onayla / Reddet çıkar. Kapalıysa ajan her zamanki gibi kendi penceresinde sorar.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When an agent asks permission for a command, Approve / Deny appears on the island. When off, the agent asks in its own window as usual."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajan bir komut için izin isteyince adada Onayla / Reddet çıkar. Kapalıysa ajan her zamanki gibi kendi penceresinde sorar."
          }
        }
      }
    },
    "Ajan bitince haber ver": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tell me when an agent finishes"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajan bitince haber ver"
          }
        }
      }
    },
    "Ajanlar": {
      "localizations": {
        "en": {
          "stringUnit": {
