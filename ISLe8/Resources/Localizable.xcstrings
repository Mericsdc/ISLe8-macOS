          "stringUnit": {
            "state": "translated",
            "value": "What's left of Claude Code, Codex and Antigravity limits, asked through each service's own command-line tool. ISLe8 reads no passwords, tokens or cookies."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code, Codex ve Antigravity'nin kalan kotası; her servisin kendi komut satırı aracıyla sorulur. ISLe8 parola, token ya da çerez okumaz."
          }
        }
      }
    },
